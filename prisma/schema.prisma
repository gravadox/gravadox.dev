generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Blogs && Apps

model App {
  id          String      @id @default(cuid())
  title       String
  description String?
  icon        String?
  banner      String?
  version     String?

  downloads   Downloads[] @relation("AppDownloads")

  github      String?

  slug        String      @unique
  tags        String[]
  blocks      Block[]     @relation("AppBlocks")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishAt   DateTime?
  pinned      Int?
}

model Downloads {
  id     String  @id @default(cuid())
  name   String
  link     String

  appId  String
  app    App     @relation("AppDownloads", fields: [appId], references: [id], onDelete: Cascade)
}

model Post {
  id          String  @id @default(cuid())
  title       String
  description String?
  banner      String?
  slug        String  @unique
  tags        String[]
  blocks      Block[] @relation("PostBlocks")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishAt   DateTime?
  pinned      Int?
}

model Block {
  id        String   @id @default(cuid())

  postId    String?
  post      Post?     @relation("PostBlocks", fields: [postId], references: [id], onDelete: Cascade)

  appId     String?
  app       App?      @relation("AppBlocks", fields: [appId], references: [id], onDelete: Cascade)

  type      BlockType
  data      Json
  createdAt DateTime @default(now())
}

enum BlockType {
  TEXT
  IMAGE
  VIDEO
  CODE
  EMBED
  BUTTON
  CANVAS
}

// Curriculum vitae

model CV {
  id       String  @id @default(cuid())
  name     String
  description String?
  photo    String?
  location String?
  phone    String?
  email    String?
  xp       XP[]
  skills   Skills[]
  extra    Json?
}

model XP {
  id      String @id @default(cuid())
  work    String
  at      String?
  date    String?
  url     String?
  cvId    String
  cv      CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)
}

model Skills {
  id      String @id @default(cuid())
  name    String
  level   SkillLevels?
  cvId    String
  cv      CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)
}

enum SkillLevels {
  EXPERT
  ADVANCED
  PROFICIENT
  INTERMEDIATE
  BEGINNER
}


model Ip{
  id  String @id @default(cuid())
  ip  String @unique
  lastUpdate DateTime
}